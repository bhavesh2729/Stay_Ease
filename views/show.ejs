
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= listing.title %> | StayEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f7f9fc;
            color: #172033;
        }

        a {
            text-decoration: none;
        }

        /* Navbar */
        .custom-navbar {
            background: #fff;
            border-bottom: 1px solid #e8edf4;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .brand {
            color: #087f8c;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .brand i {
            margin-right: 7px;
        }

        .nav-back {
            color: #344054;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-back:hover {
            color: #087f8c;
        }

        /* Main Container */
        .main-container {
            max-width: 1150px;
            margin: 42px auto;
            padding: 0 24px;
        }

        .top-info {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 25px;
        }

        .eyebrow {
            color: #087f8c;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 9px;
        }

        .listing-title {
            font-size: clamp(27px, 4vw, 39px);
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -1px;
            overflow-wrap: anywhere;
            margin-bottom: 13px;
        }

        .location-text {
            color: #667085;
            font-size: 15px;
        }

        .location-text i {
            color: #087f8c;
            margin-right: 5px;
        }

        .explore-link {
            color: #087f8c;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
            padding-bottom: 4px;
        }

        .explore-link:hover {
            color: #065d67;
        }

        /* Property Image */
        .image-wrapper {
            position: relative;
            width: 100%;
            height: 480px;
            overflow: hidden;
            border-radius: 22px;
            background: #e9eef5;
            box-shadow: 0 12px 35px rgba(16, 24, 40, 0.08);
        }

        .listing-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.6s ease;
        }

        .image-wrapper:hover .listing-image {
            transform: scale(1.025);
        }

        .image-label {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.95);
            color: #087f8c;
            padding: 9px 15px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 800;
            box-shadow: 0 4px 15px #00000012;
        }

        /* Details Layout */
        .details-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 350px;
            gap: 30px;
            align-items: start;
            margin-top: 30px;
        }

        .details-card {
            background: #fff;
            padding: 30px;
            border: 1px solid #e8edf4;
            border-radius: 20px;
            box-shadow: 0 5px 22px rgba(16, 24, 40, 0.035);
        }

        .section-title {
            font-size: 23px;
            font-weight: 800;
            margin-bottom: 15px;
            letter-spacing: -0.5px;
        }

        .description {
            color: #667085;
            font-size: 15px;
            line-height: 1.9;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .section-divider {
            border: none;
            border-top: 1px solid #e8edf4;
            margin: 27px 0;
        }

        /* Information Rows */
        .info-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 22px;
        }

        .info-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e9f8f8;
            color: #087f8c;
            border-radius: 14px;
            font-size: 19px;
        }

        .info-label {
            color: #98a2b3;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .info-value {
            color: #172033;
            font-size: 15px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        /* Price Card */
        .price-card {
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 20px;
            padding: 27px;
            box-shadow: 0 12px 35px rgba(16, 24, 40, 0.07);
            position: sticky;
            top: 25px;
        }

        .price-label {
            color: #667085;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .price {
            font-size: 33px;
            font-weight: 850;
            letter-spacing: -1px;
            color: #172033;
            overflow-wrap: anywhere;
        }

        .price span {
            font-size: 14px;
            font-weight: 500;
            color: #667085;
            letter-spacing: 0;
        }

        .price-caption {
            color: #98a2b3;
            font-size: 13px;
            margin-top: 5px;
        }

        .price-divider {
            border: none;
            border-top: 1px solid #e8edf4;
            margin: 23px 0;
        }

        .card-feature {
            display: flex;
            align-items: center;
            gap: 11px;
            color: #475467;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .card-feature i {
            color: #087f8c;
            width: 18px;
            text-align: center;
        }

        /* Action Buttons */
        .action-btn {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 13px 15px;
            margin-top: 12px;
            border-radius: 11px;
            border: 1px solid transparent;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .primary-btn {
            background: #087f8c;
            color: #fff;
        }

        .primary-btn:hover {
            background: #066670;
            color: #fff;
            transform: translateY(-2px);
        }

        .edit-btn {
            background: #172033;
            color: #fff;
        }

        .edit-btn:hover {
            background: #303b50;
            color: #fff;
            transform: translateY(-2px);
        }

        .create-btn {
            background: #e9f8f8;
            color: #087f8c;
            border-color: #d4eeee;
        }

        .create-btn:hover {
            background: #d9f1f1;
            color: #065d67;
        }

        .delete-btn {
            background: #fff;
            color: #d92d20;
            border-color: #fecdca;
        }

        .delete-btn:hover {
            background: #fff1f0;
            border-color: #fda29b;
        }

        /* Reviews & Ratings */
        .reviews-section {
            margin-top: 35px;
            padding: 30px;
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 20px;
            box-shadow: 0 5px 22px rgba(16, 24, 40, 0.04);
        }

        .review-summary {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 20px 0;
            padding: 22px;
            background: #f0fbfb;
            border-radius: 15px;
        }

        .review-average {
            font-size: 40px;
            font-weight: 800;
            color: #172033;
            line-height: 1.2;
        }

        .review-stars {
            color: #f5a623;
            letter-spacing: 2px;
            white-space: nowrap;
        }

        .review-stars .fa-regular {
            color: #d0d5dd;
        }

        .review-count {
            color: #667085;
            font-size: 13px;
            margin-top: 5px;
        }

        .review-form {
            margin-top: 25px;
            padding: 24px;
            background: #f8fafc;
            border-radius: 15px;
        }

        .review-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #d0d5dd;
            border-radius: 10px;
            background: #fff;
            color: #172033;
            resize: vertical;
        }

        .review-input:focus {
            outline: none;
            border-color: #087f8c;
            box-shadow: 0 0 0 3px #087f8c18;
        }

        .rating-options {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 5px;
            width: fit-content;
        }

        .rating-options input {
            display: none;
        }

        .rating-options label {
            cursor: pointer;
            font-size: 32px;
            color: #d0d5dd;
            transition: color 0.15s ease;
        }

        .rating-options input:checked ~ label,
        .rating-options label:hover,
        .rating-options label:hover ~ label {
            color: #f5a623;
        }

        .review-submit {
            border: none;
            border-radius: 10px;
            padding: 12px 20px;
            background: #087f8c;
            color: #fff;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }

        .review-submit:hover {
            background: #066670;
            transform: translateY(-1px);
        }

        .review-card {
            padding: 22px 0;
            border-bottom: 1px solid #e8edf4;
        }

        .review-card:last-child {
            border-bottom: none;
        }

        .review-avatar {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 50%;
            background: #e9f8f8;
            color: #087f8c;
            font-size: 18px;
            font-weight: 800;
        }

        .review-comment {
            color: #475467;
            line-height: 1.8;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .review-empty {
            text-align: center;
            padding: 35px 15px;
            color: #667085;
        }

        .review-empty i {
            color: #087f8c;
        }

        /* Google Maps Section */
        .map-section {
            margin-top: 35px;
            padding: 30px;
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 20px;
            box-shadow: 0 5px 22px rgba(16, 24, 40, 0.04);
        }

        .map-heading {
            margin-bottom: 22px;
        }

        .map-heading h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 10px;
            color: #172033;
        }

        .map-location {
            color: #667085;
            font-size: 14px;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .map-location i {
            color: #087f8c;
            margin-right: 6px;
        }

        .map-container {
            overflow: hidden;
            border-radius: 15px;
            border: 1px solid #e8edf4;
            background: #f1f5f9;
        }

        .map-container iframe {
            display: block;
            width: 100%;
            height: 400px;
            border: 0;
        }

        .map-directions {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            margin-top: 18px;
            padding: 12px 18px;
            border-radius: 10px;
            background: #087f8c;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            transition: 0.2s;
        }

        .map-directions:hover {
            background: #066670;
            color: #fff;
            transform: translateY(-2px);
        }

        /* Footer */
        .page-footer {
            margin-top: 65px;
            padding: 28px 20px;
            background: #fff;
            border-top: 1px solid #e8edf4;
            text-align: center;
            color: #98a2b3;
            font-size: 13px;
        }

        .page-footer strong {
            color: #087f8c;
        }

        /* Responsive Design */
        @media (max-width: 850px) {
            .details-grid {
                grid-template-columns: 1fr;
            }

            .price-card {
                position: static;
                order: -1;
            }

            .image-wrapper {
                height: 380px;
            }
        }

        @media (max-width: 550px) {
            .custom-navbar {
                padding: 16px 5%;
            }

            .brand {
                font-size: 23px;
            }

            .nav-back {
                font-size: 12px;
            }

            .main-container {
                margin: 28px auto;
                padding: 0 15px;
            }

            .top-info {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .listing-title {
                font-size: 28px;
            }

            .image-wrapper {
                height: 270px;
                border-radius: 15px;
            }

            .details-grid {
                gap: 18px;
                margin-top: 20px;
            }

            .details-card,
            .price-card {
                padding: 22px;
                border-radius: 16px;
            }

            .price {
                font-size: 29px;
            }

            .section-title {
                font-size: 21px;
            }

            .reviews-section {
                padding: 20px 15px;
                margin-top: 22px;
            }

            .review-form {
                padding: 18px 12px;
            }

            .review-summary {
                padding: 17px;
            }

            .review-average {
                font-size: 34px;
            }

            .review-stars {
                letter-spacing: 1px;
            }

            .review-stars i {
                font-size: 13px;
            }

            .map-section {
                padding: 20px 15px;
                margin-top: 22px;
            }

            .map-heading h2 {
                font-size: 22px;
            }

            .map-container iframe {
                height: 300px;
            }

            .map-directions {
                width: 100%;
            }
        }

/* ==========================================
   STAYEASE — PREMIUM GUEST REVIEWS DESIGN
========================================== */

/* Main reviews section */
.reviews-section {
    position: relative;
    margin-top: 42px;
    padding: 36px;
    overflow: hidden;
    background: linear-gradient(145deg, #ffffff, #fbfdff);
    border: 1px solid #e5eaf2;
    border-radius: 24px;
    box-shadow: 0 12px 40px rgba(23, 32, 51, 0.055);
}

/* Small section label */
.reviews-section .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 13px;
    margin-bottom: 13px;
    background: #e9f8f5;
    color: #087f70;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

/* Ratings & Reviews heading */
.reviews-section > .section-title {
    font-size: clamp(25px, 3vw, 32px);
    font-weight: 850;
    letter-spacing: -1px;
    color: #142b3b;
    margin-bottom: 8px;
}

/* Average rating panel */
.review-summary {
    position: relative;
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 24px 0 30px;
    padding: 25px 28px;
    background: linear-gradient(120deg, #e8f8f5, #f4faff);
    border: 1px solid #d9eeea;
    border-radius: 20px;
}

/* Large average score */
.review-average {
    min-width: 85px;
    font-size: 48px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -2px;
    color: #087f70;
}

/* Golden rating stars */
.review-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #f5a623;
    letter-spacing: 0;
}

.review-stars i {
    font-size: 15px;
}

.review-stars .fa-regular {
    color: #d4dce5;
}

/* Number of reviews */
.review-count {
    margin-top: 8px;
    color: #657487;
    font-size: 13px;
    font-weight: 600;
}

/* Share your experience form */
.review-form {
    margin-top: 28px;
    padding: 27px;
    background: #f8fbfd;
    border: 1px solid #e6edf3;
    border-radius: 20px;
}

.review-form h3 {
    color: #173344;
    font-size: 20px;
    font-weight: 800;
}

.review-form .form-label {
    color: #34495b;
    font-size: 14px;
}

.review-input {
    padding: 15px 16px;
    background: #ffffff;
    border: 1px solid #d9e2ec;
    border-radius: 13px;
    font-size: 14px;
    line-height: 1.7;
    transition: border-color 0.25s, box-shadow 0.25s;
}

.review-input:focus {
    border-color: #0b9585;
    box-shadow: 0 0 0 4px rgba(11, 149, 133, 0.10);
}

.rating-options label {
    font-size: 35px;
    line-height: 1.4;
    color: #d5dce5;
    transition: color 0.2s, transform 0.2s;
}

.rating-options label:hover {
    transform: scale(1.12);
}

.review-submit {
    padding: 13px 23px;
    background: linear-gradient(135deg, #098b7c, #076b70);
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(8, 127, 112, 0.18);
    transition: all 0.25s ease;
}

.review-submit:hover {
    background: linear-gradient(135deg, #08786c, #05595e);
    box-shadow: 0 9px 22px rgba(8, 127, 112, 0.24);
    transform: translateY(-2px);
}

/* Divider before guest feedback */
.reviews-section .section-divider {
    margin: 32px 0;
    border-color: #e5ebf2;
}

/* WHAT GUESTS ARE SAYING heading */
.reviews-section > h3.h5 {
    position: relative;
    margin-bottom: 12px !important;
    padding-left: 16px;
    color: #173344;
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 850;
    letter-spacing: -0.7px;
}

.reviews-section > h3.h5::before {
    content: "";
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 5px;
    background: linear-gradient(180deg, #12a594, #087f70);
    border-radius: 10px;
}

/* Individual guest review card */
.review-card {
    position: relative;
    margin-top: 20px;
    padding: 25px;
    background: #ffffff;
    border: 1px solid #e8edf3;
    border-radius: 19px;
    box-shadow: 0 5px 18px rgba(23, 32, 51, 0.035);
    transition: transform 0.25s ease,
                box-shadow 0.25s ease,
                border-color 0.25s ease;
}

.review-card:hover {
    transform: translateY(-3px);
    border-color: #c8e8e1;
    box-shadow: 0 12px 28px rgba(23, 32, 51, 0.075);
}

.review-card:last-child {
    border-bottom: 1px solid #e8edf3;
}

/* Guest avatar circle */
.review-avatar {
    width: 54px;
    height: 54px;
    border: 3px solid #ffffff;
    outline: 1px solid #d6eee8;
    background: linear-gradient(135deg, #d8f5ec, #e4f0ff);
    color: #087f70;
    border-radius: 50%;
    font-size: 21px;
    font-weight: 900;
    box-shadow: 0 4px 12px rgba(8, 127, 112, 0.10);
}

/* Guest name */
.review-card h4 {
    color: #193448;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.2px;
}

/* Review date */
.review-card small.text-secondary {
    display: inline-block;
    margin-top: 3px;
    color: #8996a5 !important;
    font-size: 12px;
    font-weight: 500;
}

/* Guest comment */
.review-comment {
    margin-top: 17px !important;
    margin-bottom: 0 !important;
    padding: 15px 17px;
    background: #f7fafc;
    border-left: 3px solid #a8ddd2;
    border-radius: 0 12px 12px 0;
    color: #4a5b6b;
    font-size: 14px;
    line-height: 1.9;
    overflow-wrap: anywhere;
}

/* Delete review button */
.review-card .btn-outline-danger {
    padding: 8px 12px;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 700;
    transition: all 0.2s ease;
}

.review-card .btn-outline-danger:hover {
    transform: translateY(-1px);
}

/* Empty reviews state */
.review-empty {
    margin-top: 22px;
    padding: 45px 20px;
    background: linear-gradient(145deg, #f1fbf8, #f7faff);
    border: 1px dashed #c7e5dd;
    border-radius: 20px;
}

.review-empty i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    background: #ffffff;
    border: 1px solid #dcefe9;
    border-radius: 50%;
    color: #0b9585;
    box-shadow: 0 6px 18px rgba(8, 127, 112, 0.08);
}

.review-empty h4 {
    margin-top: 10px;
    color: #193448;
    font-weight: 800;
}

.review-empty p {
    color: #758394;
    font-size: 14px;
}

/* Login notice */
.reviews-section .alert-info {
    padding: 17px 20px;
    color: #246078;
    background: #eff9fd;
    border: 1px solid #d7edf6;
    border-radius: 13px;
}

/* Responsive reviews */
@media (max-width: 550px) {
    .reviews-section {
        padding: 23px 15px;
        border-radius: 18px;
    }

    .review-summary {
        gap: 15px;
        padding: 20px 16px;
        border-radius: 15px;
    }

    .review-average {
        min-width: 68px;
        font-size: 39px;
    }

    .review-form {
        padding: 20px 14px;
    }

    .review-card {
        padding: 18px 14px;
        border-radius: 15px;
    }

    .review-avatar {
        width: 45px;
        height: 45px;
        font-size: 18px;
    }

    .review-card .review-stars {
        margin-top: 5px;
    }

    .review-card .review-stars i {
        font-size: 12px;
    }

    .review-comment {
        padding: 12px;
        font-size: 13px;
    }
}

    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="custom-navbar">
        <a href="/listing" class="brand">
            <i class="fa-solid fa-house"></i>StayEase
        </a>

        <a href="/listing" class="nav-back">
            <i class="fa-solid fa-arrow-left"></i>
            Explore Listings
        </a>
    </nav>

    <!-- Main Content -->
    <main class="main-container">

        <!-- Property Heading -->
        <div class="top-info">
            <div>
                <p class="eyebrow">Discover your next stay</p>

                <h1 class="listing-title">
                    <%= listing.title %>
                </h1>

                <p class="location-text">
                    <i class="fa-solid fa-location-dot"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>

            <a href="/listing" class="explore-link">
                Explore more stays
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- Main Property Image -->
        <div class="image-wrapper">
            <img
                class="listing-image"
                src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6' %>"
                alt="<%= listing.title %>"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6';"
            >

            <div class="image-label">
                <i class="fa-solid fa-house-chimney"></i>
                Property Details
            </div>
        </div>

        <!-- Property Details -->
        <div class="details-grid">

            <!-- About Property -->
            <section class="details-card">

                <p class="eyebrow">Your next getaway</p>

                <h2 class="section-title">About this place</h2>

                <p class="description"><%= listing.description || "Welcome to this beautiful place. Discover a comfortable stay and enjoy your trip." %></p>

                <hr class="section-divider">

                <h3 class="section-title">Property Information</h3>

                <div class="info-row">
                    <div class="info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>
                        <p class="info-label">Location</p>
                        <p class="info-value"><%= listing.location %></p>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">
                        <i class="fa-solid fa-earth-asia"></i>
                    </div>

                    <div>
                        <p class="info-label">Country</p>
                        <p class="info-value"><%= listing.country %></p>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">
                        <i class="fa-solid fa-house-chimney"></i>
                    </div>

                    <div>
                        <p class="info-label">Property</p>
                        <p class="info-value">StayEase Accommodation</p>
                    </div>
                </div>

            </section>

            <!-- Price and Actions -->
            <aside class="price-card">

                <p class="price-label">Your stay at a glance</p>

                <h2 class="price">
                    ₹<%= Number(listing.price || 0).toLocaleString("en-IN") %>
                    <span>/ night</span>
                </h2>

                <p class="price-caption">Listed price per night</p>

                <hr class="price-divider">

                <div class="card-feature">
                    <i class="fa-solid fa-location-dot"></i>
                    <span>Explore the property location</span>
                </div>

                <div class="card-feature">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>View complete property details</span>
                </div>

                <div class="card-feature">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                    <span>Price displayed in Indian Rupees</span>
                </div>

                <hr class="price-divider">

                <a href="/listing" class="action-btn primary-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Listings
                </a>

                <!-- Edit and Delete: Only Listing Owner -->
               <% if (
    currUser &&
    listing.owner &&
    String(listing.owner._id || listing.owner) === String(currUser._id)
) { %>

                    <a
                        href="/listing/<%= listing._id %>/edit"
                        class="action-btn edit-btn"
                    >
                        <i class="fa-solid fa-pen-to-square"></i>
                        Edit Listing
                    </a>

                    <form
                        action="/listing/<%= listing._id %>?_method=DELETE"
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');"
                    >
                        <button type="submit" class="action-btn delete-btn">
                            <i class="fa-solid fa-trash"></i>
                            Delete Listing
                        </button>
                    </form>

                <% } %>

                <a href="/listing/new" class="action-btn create-btn">
                    <i class="fa-solid fa-plus"></i>
                    Create New Listing
                </a>

            </aside>

        </div>

        <!-- ================= REVIEWS & RATINGS ================= -->

        <%
            const listingReviews =
                typeof reviews !== "undefined" && Array.isArray(reviews)
                    ? reviews
                    : [];

            const totalReviews = listingReviews.length;

            const averageRating = totalReviews
                ? listingReviews.reduce(
                    (sum, review) => sum + Number(review.rating || 0),
                    0
                ) / totalReviews
                : 0;

            const getAuthorId = (review) => {
                if (!review.author) return "";
                return String(review.author._id || review.author);
            };

            const formatReviewDate = (date) => {
                if (!date) return "";

                const parsedDate = new Date(date);

                return Number.isNaN(parsedDate.getTime())
                    ? ""
                    : parsedDate.toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    });
            };
        %>

        <section class="reviews-section" id="reviews">

            <p class="eyebrow">Guest feedback</p>

            <h2 class="section-title">Ratings & Reviews</h2>

            <!-- Average Rating -->
            <div class="review-summary">

                <div class="review-average">
                    <%= averageRating.toFixed(1) %>
                </div>

                <div>
                    <div class="review-stars">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <i class="<%= i <= Math.round(averageRating)
                                ? 'fa-solid'
                                : 'fa-regular' %> fa-star"></i>
                        <% } %>
                    </div>

                    <p class="review-count mb-0">
                        Based on <%= totalReviews %>
                        <%= totalReviews === 1 ? "review" : "reviews" %>
                    </p>
                </div>

            </div>

            <!-- Add Review Form -->
            <% if (currUser) { %>

                <div class="review-form">

                    <h3 class="h5 fw-bold mb-3">
                        <i class="fa-regular fa-pen-to-square me-2"></i>
                        Share your experience
                    </h3>

                    <form
                        action="/listing/<%= listing._id %>/reviews"
                        method="POST"
                    >

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Your Rating
                            </label>

                            <div class="rating-options">

                                <% for (let i = 5; i >= 1; i--) { %>

                                    <input
                                        type="radio"
                                        id="rating-<%= i %>"
                                        name="rating"
                                        value="<%= i %>"
                                        required
                                    >

                                    <label
                                        for="rating-<%= i %>"
                                        title="<%= i %> stars"
                                    >★</label>

                                <% } %>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label
                                for="comment"
                                class="form-label fw-semibold"
                            >
                                Your Comment
                            </label>

                            <textarea
                                id="comment"
                                name="comment"
                                class="review-input"
                                rows="4"
                                minlength="3"
                                maxlength="1000"
                                placeholder="Tell others about your experience..."
                                required
                            ></textarea>

                            <small class="text-secondary">
                                Maximum 1000 characters.
                            </small>

                        </div>

                        <button type="submit" class="review-submit">
                            <i class="fa-solid fa-paper-plane me-2"></i>
                            Submit Review
                        </button>

                    </form>

                </div>

            <% } else { %>

                <div class="alert alert-info mt-4">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Please
                    <a href="/login" class="fw-bold">log in</a>
                    to submit a rating and review.
                </div>

            <% } %>

            <hr class="section-divider">

            <h3 class="h5 fw-bold mb-3">
                What guests are saying
            </h3>

            <!-- Display Reviews -->
            <% if (totalReviews > 0) { %>

                <% listingReviews.forEach((review) => { %>

                    <article class="review-card">

                        <div class="d-flex align-items-start gap-3">

                            <!-- Guest Avatar -->
                            <div class="review-avatar">
                                <%= review.author && review.author.username
                                    ? review.author.username.charAt(0).toUpperCase()
                                    : "G" %>
                            </div>

                            <div class="flex-grow-1">

                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">

                                    <div>
                                        <h4 class="h6 fw-bold mb-1">
                                            <%= review.author && review.author.username
                                                ? review.author.username
                                                : "Guest" %>
                                        </h4>

                                        <small class="text-secondary">
                                            <%= formatReviewDate(review.createdAt) %>
                                        </small>
                                    </div>

                                    <!-- Individual Rating -->
                                    <div class="review-stars">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="<%= i <= Number(review.rating)
                                                ? 'fa-solid'
                                                : 'fa-regular' %> fa-star"></i>
                                        <% } %>
                                    </div>

                                </div>

                                <!-- Guest Comment -->
                                <p class="review-comment mt-3 mb-2"><%= review.comment %></p>

                                <!-- Delete Own Review -->
                                <% if (
                                    currUser &&
                                    getAuthorId(review) === String(currUser._id)
                                ) { %>

                                    <form
                                        action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST"
                                        onsubmit="return confirm('Delete your review?');"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger mt-2"
                                        >
                                            <i class="fa-solid fa-trash me-1"></i>
                                            Delete My Review
                                        </button>
                                    </form>

                                <% } %>

                            </div>

                        </div>

                    </article>

                <% }) %>

            <% } else { %>

                <div class="review-empty">

                    <i class="fa-regular fa-star fa-3x mb-3"></i>

                    <h4 class="h5 fw-bold">
                        No reviews yet
                    </h4>

                    <p class="mb-0">
                        Be the first guest to share your experience!
                    </p>

                </div>

            <% } %>

        </section>

        <!-- ================= END REVIEWS ================= -->


        <!-- Google Maps Section -->
        <section class="map-section">

            <div class="map-heading">
                <p class="eyebrow">Explore the area</p>

                <h2>Where you'll be</h2>

                <p class="map-location">
                    <i class="fa-solid fa-location-dot"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>

            <div class="map-container">
                <iframe
                    src="https://maps.google.com/maps?q=<%= encodeURIComponent((listing.location || '') + ', ' + (listing.country || '')) %>&output=embed"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Map showing <%= listing.location %>, <%= listing.country %>"
                ></iframe>
            </div>

            <a
                class="map-directions"
                href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent((listing.location || '') + ', ' + (listing.country || '')) %>"
                target="_blank"
                rel="noopener noreferrer"
            >
                <i class="fa-solid fa-diamond-turn-right"></i>
                Open in Google Maps
            </a>

        </section>

    </main>

    <!-- Footer -->
    <footer class="page-footer">
        <p>
            <strong>StayEase</strong> &copy; <%= new Date().getFullYear() %>.
            Discover places. Create memories.
        </p>
    </footer>

</body>
</html>
