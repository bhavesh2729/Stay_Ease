
<% layout("layouts/boilerplate") %>

<style>
  .service-detail-page {
    max-width: 1150px;
    margin: 20px auto 60px;
    padding: 0 15px;
    color: #222;
  }

  /* Back Link */
  .detail-back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 25px;
    color: #666;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s;
  }

  .detail-back-link:hover {
    color: #e63946;
  }

  /* Image */
  .detail-image-wrapper {
    width: 100%;
    height: 500px;
    overflow: hidden;
    border-radius: 22px;
    background: #f5f5f5;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
  }

  .detail-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .detail-image-wrapper:hover .detail-image {
    transform: scale(1.025);
  }

  .service-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    font-size: 16px;
  }

  /* Details */
  .detail-content {
    padding: 8px 5px 0 20px;
  }

  .detail-category {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 50px;
    background: #fff0f1;
    color: #d92f3d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .detail-title {
    margin: 18px 0 14px;
    font-size: clamp(27px, 3vw, 37px);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.8px;
    overflow-wrap: anywhere;
  }

  .detail-location {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #717171;
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  .detail-location i {
    color: #e63946;
  }

  .detail-divider {
    border: 0;
    border-top: 1px solid #eee;
    margin: 25px 0;
  }

  /* Host */
  .host-info {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .host-avatar {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f3f3f3;
    color: #444;
    font-size: 21px;
  }

  .host-info h6 {
    margin: 0 0 5px;
    font-size: 15px;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .host-info p {
    margin: 0;
    color: #777;
    font-size: 13px;
  }

  /* Description */
  .detail-section-title {
    margin-bottom: 14px;
    font-size: 19px;
    font-weight: 750;
  }

  .description-text {
    color: #626262;
    font-size: 15px;
    line-height: 1.9;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  /* Price Card */
  .detail-price-card {
    margin-top: 28px;
    padding: 22px;
    border: 1px solid #eee;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.045);
  }

  .price-caption {
    margin-bottom: 8px;
    color: #777;
    font-size: 13px;
  }

  .detail-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    font-size: 31px;
    font-weight: 800;
    letter-spacing: -0.7px;
  }

  .detail-price span {
    color: #777;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* Buttons */
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
  }

  .detail-btn {
    min-height: 47px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .detail-btn-edit {
    border: 1px solid #222;
    background: #222;
    color: #fff;
  }

  .detail-btn-edit:hover {
    background: #444;
    color: #fff;
    transform: translateY(-1px);
  }

  .detail-btn-delete {
    border: 1px solid #e63946;
    background: #fff;
    color: #e63946;
  }

  .detail-btn-delete:hover {
    background: #e63946;
    color: #fff;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .detail-image-wrapper {
      height: 420px;
    }

    .detail-content {
      padding: 12px 0 0;
    }
  }

  @media (max-width: 576px) {
    .service-detail-page {
      margin-top: 10px;
      padding: 0 8px;
    }

    .detail-image-wrapper {
      height: 300px;
      border-radius: 16px;
    }

    .detail-title {
      font-size: 27px;
    }

    .detail-price-card {
      padding: 18px;
    }

    .detail-actions {
      flex-direction: column;
    }

    .detail-btn {
      width: 100%;
    }
  }
</style>

<div class="service-detail-page">

  <!-- Back to Services -->
  <a href="/services" class="detail-back-link">
    <i class="fa-solid fa-arrow-left"></i>
    Back to all services
  </a>

  <div class="row g-4 g-lg-5">

    <!-- Service Image -->
    <div class="col-lg-7">
      <div class="detail-image-wrapper">

        <% if (service.image) { %>

          <img
            src="<%= service.image %>"
            alt="<%= service.title %>"
            class="detail-image"
          >

        <% } else { %>

          <div class="service-placeholder detail-image">
            <div class="text-center">
              <i class="fa-regular fa-image fa-3x mb-3"></i>
              <p class="mb-0">No image available</p>
            </div>
          </div>

        <% } %>

      </div>
    </div>

    <!-- Service Details -->
    <div class="col-lg-5">
      <div class="detail-content">

        <!-- Category -->
        <span class="detail-category">
          <i class="fa-solid fa-compass"></i>
          <%= service.category %>
        </span>

        <!-- Title -->
        <h1 class="detail-title">
          <%= service.title %>
        </h1>

        <!-- Location -->
        <p class="detail-location">
          <i class="fa-solid fa-location-dot"></i>
          <%= service.location %>
        </p>

        <hr class="detail-divider">

        <!-- Host Information -->
        <div class="host-info">
          <div class="host-avatar">
            <i class="fa-solid fa-user"></i>
          </div>

          <div>
            <h6>
              Hosted by <%= service.hostName || "Host" %>
            </h6>
            <p>Your experience, your way</p>
          </div>
        </div>

        <!-- Description -->
        <section>
          <h2 class="detail-section-title">
            About this experience
          </h2>

          <p class="description-text"><%= service.description %></p>
        </section>

        <!-- Price -->
        <div class="detail-price-card">
          <p class="price-caption">Experience price</p>

          <div class="detail-price">
            ₹<%= Number(service.price).toLocaleString("en-IN") %>

            <span>
              / <%= service.priceType || "Per guest" %>
            </span>
          </div>
        </div>

        <!-- Edit and Delete Actions -->
        <div class="detail-actions">

          <a
            href="/services/<%= service._id %>/edit"
            class="detail-btn detail-btn-edit"
          >
            <i class="fa-solid fa-pen-to-square"></i>
            Edit Service
          </a>

          <form
            action="/services/<%= service._id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Are you sure you want to delete this service?')"
          >
            <button
              type="submit"
              class="detail-btn detail-btn-delete"
            >
              <i class="fa-solid fa-trash"></i>
              Delete Service
            </button>
          </form>

        </div>

      </div>
    </div>

  </div>
</div>