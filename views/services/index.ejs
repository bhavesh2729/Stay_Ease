<%- layout("layouts/boilerplate") %>

<style>
  /* Main Page */
  .services-page {
    max-width: 1320px;
    margin: 0 auto;
    padding: 48px 24px 75px;
    color: #222;
  }

  /* Header */
  .services-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 35px;
  }

  .services-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -1px;
    margin: 0 0 10px;
  }

  .services-subtitle {
    color: #717171;
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  .services-count {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #666;
    font-size: 13px;
    margin-top: 12px;
  }

  .services-count i {
    color: #ff385c;
  }

  /* Host Button */
  .host-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 21px;
    background: #ff385c;
    color: #fff;
    border: 1px solid #ff385c;
    border-radius: 11px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: background .2s, transform .2s, box-shadow .2s;
  }

  .host-btn:hover {
    background: #e31c5f;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 7px 18px rgba(255, 56, 92, .2);
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 22px;
  }

  /* Card */
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid #ededed;
    border-radius: 18px;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, .09);
  }

  /* Image */
  .service-image-wrap {
    position: relative;
    height: 235px;
    flex-shrink: 0;
    overflow: hidden;
    background: #f3f3f3;
  }

  .service-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .service-card:hover .service-image {
    transform: scale(1.055);
  }

  .service-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    color: #b0b0b0;
    font-size: 45px;
  }

  .category-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    max-width: calc(100% - 28px);
    padding: 7px 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: rgba(255, 255, 255, .96);
    color: #333;
    border: 1px solid rgba(0, 0, 0, .04);
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 3px 10px rgba(0, 0, 0, .06);
  }

  /* Card Content */
  .service-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 21px;
    min-width: 0;
  }

  .service-title {
    font-size: 18px;
    line-height: 1.45;
    font-weight: 750;
    color: #222;
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }

  .service-location {
    color: #717171;
    font-size: 13px;
    margin-bottom: 13px;
    overflow-wrap: anywhere;
  }

  .service-location i {
    color: #ff385c;
  }

  .service-description {
    color: #666;
    font-size: 14px;
    line-height: 1.75;
    margin: 0 0 22px;
    overflow-wrap: anywhere;
  }

  /* Price and Details */
  .service-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid #eee;
    padding-top: 16px;
    margin-top: auto;
  }

  .service-price {
    color: #222;
    font-size: 19px;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .service-price small {
    color: #717171;
    font-size: 12px;
    font-weight: 400;
    white-space: nowrap;
  }

  .host-name {
    color: #777;
    font-size: 12px;
    margin-top: 6px;
    overflow-wrap: anywhere;
  }

  .view-service-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 10px 13px;
    background: #222;
    color: #fff;
    border-radius: 9px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    transition: background .2s;
  }

  .view-service-btn:hover {
    background: #ff385c;
    color: #fff;
  }

  /* Empty State */
  .empty-services {
    text-align: center;
    padding: 70px 24px;
    background: #fafafa;
    border: 1px dashed #ddd;
    border-radius: 20px;
  }

  .empty-icon {
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
    border-radius: 24px;
    background: #ffe8ed;
    color: #ff385c;
    font-size: 32px;
  }

  .empty-services h3 {
    font-size: 23px;
    font-weight: 750;
    margin-bottom: 10px;
  }

  .empty-services p {
    color: #717171;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .service-image-wrap {
      height: 225px;
    }
  }

  @media (max-width: 650px) {
    .services-page {
      padding: 30px 15px 48px;
    }

    .services-header {
      align-items: stretch;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 27px;
    }

    .services-header h1 {
      font-size: 1.9rem;
    }

    .host-btn {
      width: 100%;
    }

    .services-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    .service-image-wrap {
      height: 245px;
    }

    .service-card-body {
      padding: 19px;
    }
  }

  @media (max-width: 380px) {
    .service-card-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .view-service-btn {
      width: 100%;
    }
  }
</style>

<div class="services-page">

  <!-- Page Header -->
  <header class="services-header">
    <div>
      <h1>Discover Services</h1>

      <p class="services-subtitle">
        Find unique experiences and discover talented local hosts.
      </p>

      <% if (allServices && allServices.length > 0) { %>
        <div class="services-count">
          <i class="fa-solid fa-sparkles"></i>
          <%= allServices.length %>
          <%= allServices.length === 1 ? "service" : "services" %>
          available
        </div>
      <% } %>
    </div>

    <a href="/services/new" class="host-btn">
      <i class="fa-solid fa-plus"></i>
      Become a Host
    </a>
  </header>

  <!-- Services Grid -->
  <% if (allServices && allServices.length > 0) { %>

    <div class="services-grid">

      <% allServices.forEach((service) => { %>

        <article class="service-card">

          <!-- Image -->
          <div class="service-image-wrap">

            <div class="service-placeholder">
              <i class="fa-solid fa-camera"></i>
            </div>

            <% if (service.imageUrl || service.image) { %>
              <img
                src="<%= service.imageUrl || service.image %>"
                class="service-image"
                alt="<%= service.title || 'Service image' %>"
                loading="lazy"
                onload="this.previousElementSibling.style.display='none';"
                onerror="this.style.display='none';"
              >
            <% } %>

            <span class="category-badge">
              <%= service.category || "Other" %>
            </span>

          </div>

          <!-- Service Details -->
          <div class="service-card-body">

            <h2 class="service-title">
              <%= service.title || "Untitled Service" %>
            </h2>

            <p class="service-location">
              <i class="fa-solid fa-location-dot me-1"></i>
              <%= service.location || "Location not specified" %>
            </p>

            <p class="service-description">
              <%
                const description = service.description || "";
              %>
              <%= description.length > 110
                ? description.substring(0, 110) + "..."
                : description %>
            </p>

            <!-- Footer -->
            <div class="service-card-footer">

              <div>
                <div class="service-price">
                  ₹<%= Number(service.price || 0).toLocaleString("en-IN") %>

                  <small>
                    / <%= service.priceType === "Per guest"
                      ? "guest"
                      : "group" %>
                  </small>
                </div>

                <div class="host-name">
                  <i class="fa-regular fa-user me-1"></i>
                  Hosted by <%= service.hostName || "Host" %>
                </div>
              </div>

              <a
                href="/services/<%= service._id %>"
                class="view-service-btn"
              >
                View Details
                <i class="fa-solid fa-arrow-right"></i>
              </a>

            </div>
          </div>

        </article>

      <% }) %>

    </div>

  <% } else { %>

    <!-- Empty State -->
    <section class="empty-services">

      <div class="empty-icon">
        <i class="fa-solid fa-compass"></i>
      </div>

      <h3>No services available yet</h3>

      <p>
        Be the first host to share a skill, create an experience,
        and connect with guests.
      </p>

      <a href="/services/new" class="host-btn">
        <i class="fa-solid fa-plus"></i>
        Create Your First Service
      </a>

    </section>

  <% } %>

</div>