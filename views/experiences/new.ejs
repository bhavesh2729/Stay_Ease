
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Add Experience | StayEase</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f7f7f7;
      margin: 0;
      padding: 30px;
    }

    .container {
      max-width: 650px;
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 2px 10px #ddd;
    }

    h1 {
      text-align: center;
      color: #ff385c;
    }

    label {
      display: block;
      margin-top: 15px;
      font-weight: bold;
    }

    input, textarea, select {
      width: 100%;
      padding: 10px;
      margin-top: 6px;
      box-sizing: border-box;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    button {
      width: 100%;
      padding: 12px;
      margin-top: 22px;
      background: #ff385c;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
    }

    button:hover {
      background: #e31c5f;
    }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: #333;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>Create a New Experience</h1>

    <form action="/experiences" method="POST">

      <label for="title">Experience Title</label>
      <input
        type="text"
        id="title"
        name="experience[title]"
        placeholder="e.g. Mumbai City Tour"
        required
      >

      <label for="description">Description</label>
      <textarea
        id="description"
        name="experience[description]"
        placeholder="Describe your experience..."
        required
      ></textarea>

      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="experience[location]"
        placeholder="e.g. Mumbai, Maharashtra"
        required
      >

      <label for="price">Price per Guest (₹)</label>
      <input
        type="number"
        id="price"
        name="experience[price]"
        min="0"
        placeholder="e.g. 1500"
        required
      >

      <label for="image">Image URL</label>
      <input
        type="url"
        id="image"
        name="experience[image]"
        placeholder="https://example.com/image.jpg"
      >

      <label for="category">Category</label>
      <select id="category" name="experience[category]">
        <option value="City Tour">City Tour</option>
        <option value="Cooking">Cooking</option>
        <option value="Adventure">Adventure</option>
        <option value="Photography">Photography</option>
        <option value="Culture">Culture</option>
        <option value="Nature">Nature</option>
        <option value="Other">Other</option>
      </select>

      <label for="duration">Duration</label>
      <input
        type="text"
        id="duration"
        name="experience[duration]"
        placeholder="e.g. 3 hours"
      >

      <button type="submit">Create Experience</button>
    </form>

    <a class="back-link" href="/experiences">
      ← Back to Experiences
    </a>
  </div>
</body>
</html>
